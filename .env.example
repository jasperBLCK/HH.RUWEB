# hh.ru OAuth-приложение: https://dev.hh.ru/admin
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:8000/auth/callback
HH_USER_AGENT=HH.RUWEB/0.1 (your-email@example.com)

# LLM: любой OpenAI-совместимый провайдер. Без ключа работает keyword-скоринг.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

DATABASE_URL=sqlite:///./hhruweb.db
